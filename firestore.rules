rules_version = '2';

// ---------------------------------------------------------------
// Reglas de seguridad de Mara Comercio.
//
// La clave de Firebase que viaja en el navegador es pública por diseño: lo
// que de verdad protege los datos es este archivo. Se despliega con:
//     firebase deploy --only firestore:rules
// ---------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function esMio(uid) {
      return autenticado() && request.auth.uid == uid;
    }

    // Correo dueño de la plataforma. Cambiar aquí si pasa a otras manos, y
    // mantenerlo igual que NEXT_PUBLIC_ADMIN_EMAIL en el entorno.
    //
    // Se exige el correo verificado a propósito: sin esa condición, quien
    // registrase primero esa dirección en Firebase se quedaría con el mando.
    // Se comprueba que el token traiga correo antes de leerlo: los miembros
    // del pueblo entran con su teléfono, y sin esta guarda la regla lanzaría
    // un error de evaluación en cada operación suya. Deniega igual, pero por
    // accidente en vez de por decisión, y eso se rompe en cuanto algo cambie.
    function esDueno() {
      return autenticado()
        && 'email' in request.auth.token
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'paulalejo123@gmail.com'
        && 'email_verified' in request.auth.token
        && request.auth.token.email_verified == true;
    }

    /**
     * La foto de perfil de quien escribe sigue en pie.
     *
     * La foto es lo que permite reconocer a alguien al cerrar un trato en la
     * calle. Cuando la administración marca que no es de la persona, la cuenta
     * queda en pausa hasta que la cambie: puede entrar y arreglar su perfil,
     * pero no publicar ni escribir en el chat. Si esto solo lo comprobara la
     * interfaz, bastaría con abrir la consola del navegador para saltárselo.
     */
    function fotoEnPie() {
      return autenticado()
        && exists(/databases/$(database)/documents/miembros/$(request.auth.uid))
        && get(/databases/$(database)/documents/miembros/$(request.auth.uid))
             .data.get('fotoRechazada', false) == false;
    }

    /**
     * Miembro verificado por la administración.
     *
     * Es la llave del tablón de divisas: publicar una oferta de dólares
     * significa citar a un vecino para un intercambio de efectivo en mano,
     * así que no basta con estar registrado.
     */
    function miembroVerificado() {
      return autenticado()
        && exists(/databases/$(database)/documents/miembros/$(request.auth.uid))
        && get(/databases/$(database)/documents/miembros/$(request.auth.uid)).data.verificado == true;
    }

    /**
     * Los datos del autor que cada publicación y cada mensaje llevan copiados
     * dentro (nombre, apellido, teléfono, foto y el sello de verificado).
     *
     * Se duplican para pintar una lista sin una lectura por tarjeta, pero eso
     * los convierte en datos que el cliente envía: sin comprobarlos, cualquiera
     * podría publicar con el nombre y la foto de un vecino de confianza, marcarse
     * el sello de verificado y poner su propio teléfono. En una plataforma donde
     * la gente queda en persona con efectivo, eso es suplantación.
     *
     * Por eso se contrastan aquí contra el perfil real de quien escribe.
     */
    function autorCoincideConSuPerfil() {
      let perfil = get(/databases/$(database)/documents/miembros/$(request.auth.uid)).data;
      let nuevo = request.resource.data;
      return nuevo.autorCodigo == perfil.codigo
        && nuevo.autorNombre == perfil.nombre
        && nuevo.autorApellido == perfil.apellido
        && nuevo.autorTelefono == perfil.telefono
        && nuevo.autorFoto == perfil.fotoUrl
        && nuevo.autorVerificado == perfil.verificado
        // El distintivo de Vendedor Seguro es el que decide quién encabeza el
        // tablón de divisas, así que es justo el que más tienta a falsificar.
        //
        // Aquí no se exige igualdad sino que nadie se atribuya de más: ponerlo
        // en falso siempre vale; ponerlo en cierto, solo si el perfil lo dice.
        // Con igualdad estricta, un navegador con la versión anterior de la
        // página en caché dejaría de poder publicar el día del despliegue, y
        // eso castiga justo a quien sí está avalado. Entenderse de menos no
        // hace daño a nadie; entenderse de más es la suplantación que se está
        // evitando.
        //
        // Se lee con get(campo, por_defecto) porque ni los perfiles ni los
        // anuncios anteriores a la distinción tienen todavía ese campo.
        && (nuevo.get('autorSeguro', false) == false
            || perfil.get('vendedorSeguro', false) == true);
    }

    /** Los datos copiados del autor siguen siendo los que ya estaban guardados. */
    function autorSinCambios() {
      let nuevo = request.resource.data;
      let viejo = resource.data;
      return nuevo.autorCodigo == viejo.autorCodigo
        && nuevo.autorNombre == viejo.autorNombre
        && nuevo.autorApellido == viejo.autorApellido
        && nuevo.autorTelefono == viejo.autorTelefono
        && nuevo.autorFoto == viejo.autorFoto
        && nuevo.autorVerificado == viejo.autorVerificado
        && nuevo.get('autorSeguro', false) == viejo.get('autorSeguro', false);
    }

    /**
     * Una imagen de la plataforma, y no de cualquier sitio de internet.
     *
     * Todas las fotos se suben a esta cuenta de Cloudinary, así que una URL que
     * apunte a otro lado no puede venir de la aplicación: viene de alguien
     * escribiendo directo contra la base. Y eso importa más de lo que parece,
     * porque una imagen alojada fuera la controla otro: se aprueba una foto de
     * perfil y al día siguiente esa misma dirección sirve otra cosa. También
     * evita que un perfil se convierta en un píxel de rastreo que registre a
     * todo el que abra el directorio.
     */
    function imagenPropia(valor) {
      return valor is string
        && valor.size() <= 500
        && valor.matches('https://res[.]cloudinary[.]com/bzrjdfnu/.*');
    }

    /**
     * Las fotos de una publicación.
     *
     * Se comprueban una a una porque el lenguaje de reglas no sabe recorrer
     * listas. Es repetitivo y se ve, pero el tope son cinco fotos —el mismo que
     * pone el formulario— así que la lista de comprobaciones es corta y acaba.
     */
    function imagenesPropias() {
      let fotos = request.resource.data.get('imagenes', []);
      return fotos is list
        && fotos.size() <= 5
        && (fotos.size() < 1 || imagenPropia(fotos[0]))
        && (fotos.size() < 2 || imagenPropia(fotos[1]))
        && (fotos.size() < 3 || imagenPropia(fotos[2]))
        && (fotos.size() < 4 || imagenPropia(fotos[3]))
        && (fotos.size() < 5 || imagenPropia(fotos[4]));
    }

    /** Una cadena que existe y no se pasa de larga. */
    function acotada(valor, maximo) {
      return valor is string && valor.size() <= maximo;
    }

    /**
     * Los textos libres de una publicación, con tope.
     *
     * Sin esto, una sola publicación con una descripción de medio megabyte
     * encarece cada lectura de la sección entera para todo el pueblo. El
     * formulario ya los limita, pero el formulario no es la frontera.
     */
    function textosAcotados() {
      let d = request.resource.data;
      return acotada(d.get('descripcion', ''), 2000)
        && acotada(d.get('zona', ''), 80)
        && acotada(d.get('categoria', ''), 120)
        && acotada(d.get('direccion', ''), 300)
        && acotada(d.get('horario', ''), 200)
        && acotada(d.get('enlace', ''), 500)
        && acotada(d.get('modelo', ''), 80)
        && acotada(d.get('placa', ''), 12)
        && acotada(d.get('premio', ''), 200)
        && acotada(d.get('loteria', ''), 80)
        && acotada(d.get('origen', ''), 120)
        && acotada(d.get('destino', ''), 120)
        && d.get('categorias', []) is list
        && d.get('categorias', []).size() <= 12;
    }

    /** Marca de tiempo en milisegundos que de verdad corresponde a ahora. */
    function marcaReciente(valor) {
      return valor is int
        && valor <= request.time.toMillis() + 120000
        && valor >= request.time.toMillis() - 300000;
    }

    function esAdmin() {
      return esDueno()
        || (autenticado()
            && exists(/databases/$(database)/documents/administradores/$(request.auth.uid)));
    }

    // Administradores. Solo el correo dueño reparte y retira permisos: ningún
    // administrador puede nombrar a otro ni quitarse a sí mismo del medio.
    match /administradores/{uid} {
      // La lista de administradores solo la ve la propia administración: no
      // hace falta que todo el pueblo sepa a quién dirigirse para presionar.
      allow read: if esAdmin();
      allow write: if esDueno();
    }

    // Perfiles. Son públicos a propósito: la foto, el nombre y el teléfono son
    // lo que permite reconocer a la otra persona antes de cerrar un trato.
    match /miembros/{uid} {
      allow read: if true;
      allow create: if esMio(uid)
        && request.resource.data.uid == uid
        && request.resource.data.rol == 'miembro'
        && request.resource.data.verificado == false
        && imagenPropia(request.resource.data.fotoUrl)
        && acotada(request.resource.data.nombre, 60)
        && acotada(request.resource.data.apellido, 60)
        && acotada(request.resource.data.telefono, 20)
        && acotada(request.resource.data.get('zona', ''), 80);

      // Cada quien edita su ficha, pero nadie se asciende, se autoverifica,
      // se nombra Vendedor Seguro ni se cambia el código. Pedir la
      // verificación sí es cosa suya.
      allow update: if esAdmin()
        || (esMio(uid)
            && request.resource.data.rol == resource.data.rol
            && request.resource.data.verificado == resource.data.verificado
            && request.resource.data.get('vendedorSeguro', false)
                 == resource.data.get('vendedorSeguro', false)
            && request.resource.data.codigo == resource.data.codigo
            // La foto rechazada solo se apaga subiendo otra distinta. Sin esta
            // condición, la pausa se levantaría borrando un campo desde la
            // consola y la foto falsa seguiría ahí.
            && imagenPropia(request.resource.data.fotoUrl)
            && acotada(request.resource.data.nombre, 60)
            && acotada(request.resource.data.apellido, 60)
            && acotada(request.resource.data.telefono, 20)
            && acotada(request.resource.data.get('zona', ''), 80)
            && (request.resource.data.get('fotoRechazada', false)
                  == resource.data.get('fotoRechazada', false)
                || (request.resource.data.get('fotoRechazada', false) == false
                    && request.resource.data.fotoUrl != resource.data.fotoUrl))
            // La advertencia la pone y la quita la administración.
            && request.resource.data.get('advertencia', '')
                 == resource.data.get('advertencia', ''));

      allow delete: if esAdmin();
    }

    // Correlativo de los identificadores MC-00000.
    // Solo se deja incrementar de uno en uno, para que nadie queme el contador.
    match /contadores/miembros {
      allow read: if true;
      allow write: if autenticado()
        && request.resource.data.ultimo is int
        && (!exists(/databases/$(database)/documents/contadores/miembros)
            || request.resource.data.ultimo == resource.data.ultimo + 1);
    }

    /**
     * El vencimiento lo escribe el cliente, así que hay que acotarlo: sin
     * tope, una oferta de divisas podría fijarse a diez años y saltarse las
     * seis horas que mantienen el tablón fresco.
     */
    function vigenciaRazonable() {
      let tipo = request.resource.data.tipo;
      let vence = request.resource.data.venceEn;
      return vence is int
        // Los negocios del directorio y las fichas de mototaxi y taxi no
        // caducan: son de quién es alguien, no de algo que se acaba.
        && (tipo == 'negocio' || tipo == 'mototaxi'
            || (tipo == 'divisa' && vence <= request.time.toMillis() + 25200000)
            // Una carrera pedida vive dos horas. Tres de tope para que un
            // reloj desajustado no rechace una petición legítima.
            || (tipo == 'carrera' && vence <= request.time.toMillis() + 10800000)
            // Una rifa vive hasta el día después de su sorteo, y un sorteo se
            // anuncia con meses de antelación: quien rifa para Navidad empieza
            // a vender los números en octubre. Con el tope de 32 días del
            // marketplace, esa rifa era imposible de publicar. Se deja un año
            // largo, que es el margen en el que una rifa sigue siendo creíble.
            || (tipo == 'rifa' && vence <= request.time.toMillis() + 34560000000)
            || (tipo != 'divisa' && tipo != 'carrera' && tipo != 'rifa'
                && vence <= request.time.toMillis() + 2764800000));
    }

    // Publicaciones: mercado, negocios, transporte, divisas, rifas y las
    // carreras que el pueblo pide.
    match /publicaciones/{id} {
      allow read: if true;

      allow create: if autenticado()
        && request.resource.data.autorUid == request.auth.uid
        && fotoEnPie()
        && autorCoincideConSuPerfil()
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() > 0
        && request.resource.data.titulo.size() <= 200
        && imagenesPropias()
        && textosAcotados()
        && request.resource.data.tipo in
             ['producto', 'negocio', 'mototaxi', 'divisa', 'rifa', 'carrera']
        && (request.resource.data.tipo != 'divisa' || miembroVerificado())
        // Sin esto, una fecha de creación en el futuro dejaría el anuncio
        // clavado en el primer puesto de todos los listados para siempre.
        && marcaReciente(request.resource.data.creadaEn)
        // Destacar se paga y lo concede la administración. Sin esta línea,
        // cualquiera se pondría en el primer puesto de su sección escribiendo
        // un campo más desde la consola del navegador.
        && request.resource.data.get('destacadaHasta', 0) == 0
        && vigenciaRazonable();

      // El autor puede editar y prorrogar la suya. Nunca cambian quién firma,
      // qué tipo es ni cuándo se creó.
      //
      // Los datos copiados del autor pueden quedarse como estaban o pasar a
      // coincidir con su perfil actual, pero no inventarse: así quien cambia
      // de teléfono puede refrescar sus anuncios, y nadie puede ponerles el
      // nombre de otro.
      allow update: if esAdmin()
        || (esMio(resource.data.autorUid)
            && request.resource.data.autorUid == resource.data.autorUid
            && request.resource.data.tipo == resource.data.tipo
            && request.resource.data.creadaEn == resource.data.creadaEn
            && (autorSinCambios() || autorCoincideConSuPerfil())
            && acotada(request.resource.data.titulo, 200)
            && imagenesPropias()
            && textosAcotados()
            && (resource.data.tipo != 'divisa' || miembroVerificado())
            // Ni prorrogando, ni corrigiendo el precio, ni marcándolo vendido:
            // el destaque solo se mueve desde la administración.
            && request.resource.data.get('destacadaHasta', 0)
                 == resource.data.get('destacadaHasta', 0)
            && vigenciaRazonable());

      allow delete: if esAdmin() || esMio(resource.data.autorUid);
    }

    // Chat en vivo. Los mensajes se borran solos a las 24 horas mediante la
    // política TTL sobre el campo `expiraEn`; aquí solo se controla quién
    // puede escribir y que nadie firme con el nombre de otro.
    match /salas/{sala}/mensajes/{id} {
      allow read: if true;

      allow create: if autenticado()
        && sala == 'general'
        && fotoEnPie()
        && request.resource.data.autorUid == request.auth.uid
        && request.resource.data.autorCodigo ==
             get(/databases/$(database)/documents/miembros/$(request.auth.uid)).data.codigo
        && request.resource.data.autorNombre ==
             get(/databases/$(database)/documents/miembros/$(request.auth.uid)).data.nombre
        && request.resource.data.texto is string
        && request.resource.data.texto.size() <= 1000
        // Si adjunta imagen, tiene que ser una subida aquí.
        && (!('imagenUrl' in request.resource.data)
            || imagenPropia(request.resource.data.imagenUrl))
        // Una fecha futura dejaría el mensaje fijo al final de la sala, y un
        // vencimiento lejano lo salvaría del borrado a las 24 horas. Se deja
        // una hora de holgura para no rechazar a quien tenga el reloj corrido.
        && marcaReciente(request.resource.data.creadoEn)
        && request.resource.data.expiraEn is timestamp
        && request.resource.data.expiraEn < request.time + duration.value(25, 'h');

      // Un mensaje no se edita: se borra. Así nadie reescribe lo que dijo.
      allow update: if false;
      allow delete: if esAdmin() || esMio(resource.data.autorUid);
    }

    /**
     * Reportes de la comunidad.
     *
     * Los lee solo la administración, y es la decisión de diseño que hace que
     * el sistema funcione: en un pueblo donde todos se conocen, un tablón
     * público de "quién acusó a quién" no se usaría ni una vez. Quien reporta
     * tiene que poder hacerlo sin quedar expuesto.
     *
     * El identificador del documento lo compone el cliente como
     * objetivo_reportante, así que cada persona ocupa un solo renglón por
     * cosa reportada: sin eso, un enfadado podría enterrar la cola con
     * cincuenta avisos del mismo anuncio.
     */
    match /reportes/{id} {
      allow read: if esAdmin();

      allow create: if autenticado()
        && request.resource.data.reportanteUid == request.auth.uid
        // El identificador se comprueba aquí, y no solo se documenta: si el
        // cliente pudiera inventárselo, un enfadado abriría cincuenta
        // renglones del mismo anuncio y la cola dejaría de servir.
        && id == request.resource.data.sobre + '_'
               + request.resource.data.objetivoId + '__' + request.auth.uid
        && request.resource.data.reportanteCodigo ==
             get(/databases/$(database)/documents/miembros/$(request.auth.uid)).data.codigo
        && request.resource.data.sobre in ['publicacion', 'miembro']
        && request.resource.data.motivo in
             ['estafa', 'no-existe', 'precio-enganoso', 'ofensivo', 'repetido', 'otro']
        && request.resource.data.detalle is string
        && request.resource.data.detalle.size() <= 1000
        // Un reporte entra siempre abierto: quien avisa no cierra su propio
        // aviso, y así la cola refleja lo que falta por mirar.
        && request.resource.data.estado == 'abierto'
        // Reportarse a uno mismo solo sirve para ensuciar la cola.
        && request.resource.data.objetivoAutorUid != request.auth.uid
        && marcaReciente(request.resource.data.creadoEn);

      // Quien reportó puede corregir su motivo y su relato mientras nadie lo
      // haya atendido; resolverlo o descartarlo es cosa de la administración.
      //
      // Lo reportado queda clavado. Sin fijarlo, un aviso ya puesto podía
      // reescribirse para señalar a otra persona: el renglón seguía diciendo
      // "estafa", el identificador seguía siendo el mismo, y el acusado pasaba
      // a ser cualquiera. La administración habría actuado sobre eso.
      allow update: if esAdmin()
        || (esMio(resource.data.reportanteUid)
            && resource.data.estado == 'abierto'
            && request.resource.data.estado == 'abierto'
            && request.resource.data.reportanteUid == resource.data.reportanteUid
            && request.resource.data.sobre == resource.data.sobre
            && request.resource.data.objetivoId == resource.data.objetivoId
            && request.resource.data.objetivoAutorUid == resource.data.objetivoAutorUid
            && request.resource.data.creadoEn == resource.data.creadoEn
            && request.resource.data.motivo in
                 ['estafa', 'no-existe', 'precio-enganoso', 'ofensivo', 'repetido', 'otro']
            && request.resource.data.detalle is string
            && request.resource.data.detalle.size() <= 1000);

      // Un reporte no se borra ni por quien lo puso: si se pudiera retirar,
      // bastaría una llamada incómoda para que desapareciera del panel.
      allow delete: if esAdmin();
    }

    // Respaldo manual de las tasas del dólar, por si la fuente pública falla.
    match /configuracion/{documento} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Todo lo que no esté contemplado arriba queda cerrado.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
