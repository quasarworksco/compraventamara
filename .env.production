# ---------------------------------------------------------------
# Configuración de producción de Mara Comercio.
#
# Este archivo SÍ se versiona, y es deliberado: todos sus valores son
# `NEXT_PUBLIC_*`, es decir, viajan dentro del paquete que descarga el
# navegador de cualquier visitante. Tenerlos aquí no los expone más de lo
# que ya lo están, y a cambio el despliegue no necesita configuración manual
# en Vercel.
#
# Lo que de verdad protege los datos son las reglas de firestore.rules.
# Nunca poner aquí una clave privada: ni el API secret de Cloudinary, ni una
# credencial de cuenta de servicio de Firebase.
# ---------------------------------------------------------------

# Firebase — proyecto maracomercio-94d8a
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDFSdU2rXeMpUypJ8MKMwZZbNdUZMAMEV4
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=maracomercio-94d8a.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=maracomercio-94d8a
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=maracomercio-94d8a.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=418813524726
NEXT_PUBLIC_FIREBASE_APP_ID=1:418813524726:web:afa370eddf45b64bc10ad7

# Cloudinary — fotos de perfil y de publicaciones
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=bzrjdfnu
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=maracommerce

# Correo dueño del panel /admin. Debe coincidir con la función esDueno()
# de firestore.rules y estar verificado en Firebase.
NEXT_PUBLIC_ADMIN_EMAIL=kevinbermudez1412@gmail.com
