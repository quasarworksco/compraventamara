# ---------------------------------------------------------------
# Copia este archivo como `.env.local` y rellena los valores.
# En Vercel, cárgalos en Settings -> Environment Variables.
# ---------------------------------------------------------------

# Cloudinary -> Dashboard (cloud name) y Settings -> Upload -> Upload presets
# El preset debe estar en modo "Unsigned" para que el navegador pueda subir.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=tu-upload-preset

# Firebase -> Configuración del proyecto -> Tus apps -> Configuración del SDK
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Correo dueño del panel de administración (/admin). Es el único que puede
# nombrar o quitar administradores, y debe estar verificado en Firebase.
# Tiene que coincidir con el correo de la función esDueno() en firestore.rules.
NEXT_PUBLIC_ADMIN_EMAIL=tu-correo@ejemplo.com
